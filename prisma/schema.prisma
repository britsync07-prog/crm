generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String              @id @default(cuid())
  name                String?
  email               String              @unique
  password            String
  role                String              @default("USER")
  status              String              @default("ACTIVE")
  bannedAt            DateTime?
  bannedBy            String?
  isVerified          Boolean             @default(false)
  newsletterOptedIn   Boolean             @default(true)
  verifyToken         String?
  resetToken          String?
  resetExpires        DateTime?
  image               String?
  organizationId      String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  activityLogs        ActivityLog[]
  automations         Automation[]
  bookings            Booking[]           @relation("UserBookings")
  calendarEvents      CalendarEvent[]
  calendarSettings    CalendarSettings?
  campaigns           Campaign[]
  categories          Category[]
  customers           Customer[]
  deals               Deal[]
  emailAccounts       EmailAccount[]
  employeeProfile     Employee?
  forms               Form[]              @relation("UserForms")
  leads               Lead[]
  createdMeetings     Meeting[]           @relation("CreatedMeetings")
  notifications       Notification[]
  rooms               Room[]              @relation("UserRooms")
  scrapeJobs          ScrapeJob[]
  socialAccounts      SocialAccount[]
  assignedTasks       Task[]              @relation("AssignedTasks")
  workspaces          Workspace[]         @relation("WorkspaceOwner")
  workspaceMessages   WorkspaceMessage[]  @relation("WorkspaceMessages")
  workspacesAdmin     WorkspaceUser[]
  customRoles         WorkspaceUserRole[]
  ownedOrganization   Organization?       @relation("OwnedOrganization")
  memberProfile       OrganizationMember?
  invitedMembers      OrganizationMember[] @relation("InvitedBy")
  mcpAccessTokens     McpAccessToken[]
  ownedOnboardings    OnboardingInstance[] @relation("OnboardingOwner")
}

model McpAccessToken {
  id         String    @id @default(cuid())
  userId     String
  name       String    @default("MCP Agent")
  tokenHash  String    @unique
  lastFour   String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id                   String               @id @default(cuid())
  name                 String               @default("My Organization")
  ownerId              String               @unique
  plan                 String               @default("free")
  seatLimit            Int                  @default(1)
  stripeCustomerId     String?              @unique
  stripeSubscriptionId String?              @unique
  subscriptionStatus   String               @default("free")
  subscriptionEndDate  DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  owner                User                 @relation("OwnedOrganization", fields: [ownerId], references: [id])
  members              OrganizationMember[]
}

model OrganizationMember {
  id               String       @id @default(cuid())
  organizationId   String
  userId           String?      @unique
  email            String
  role             String       @default("member")
  status           String       @default("pending")
  inviteToken      String       @unique @default(cuid())
  invitedById      String
  lastActive       DateTime?
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id])
  user             User?        @relation(fields: [userId], references: [id])
  invitedBy        User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([organizationId, email])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  channels    Channel[]
  employees   Employee[]
  pipelines   Pipeline[]
  projects    Project[]
  socialPosts SocialPost[]
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  invites     WorkspaceInvite[]
  roles       WorkspaceRole[]
  users       WorkspaceUser[]
}

model WorkspaceUser {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER")
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, userId])
}

model WorkspaceRole {
  id              String              @id @default(cuid())
  workspaceId     String
  name            String
  color           String              @default("#6366f1")
  createdAt       DateTime            @default(now())
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  users           WorkspaceUserRole[]
  allowedChannels Channel[]           @relation("ChannelToWorkspaceRole")
}

model WorkspaceUserRole {
  userId String
  roleId String
  role   WorkspaceRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Channel {
  id           String             @id @default(cuid())
  name         String
  workspaceId  String
  isPrivate    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages     WorkspaceMessage[]
  allowedRoles WorkspaceRole[]    @relation("ChannelToWorkspaceRole")
}

model WorkspaceMessage {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation("WorkspaceMessages", fields: [userId], references: [id])
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model WorkspaceInvite {
  id          String    @id @default(uuid())
  workspaceId String
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Meeting {
  id               String   @id @default(cuid())
  meetingId        String   @unique
  hostId           String
  title            String
  status           String   @default("ACTIVE")
  startTime        DateTime @default(now())
  endTime          DateTime @default(now())
  createdAt        DateTime @default(now())
  formId           String?
  formSubmissionId String?
  metadata         String?
  submitterEmail   String?
  host             User     @relation("CreatedMeetings", fields: [hostId], references: [id])
}

model Employee {
  id          String       @id @default(cuid())
  userId      String       @unique
  workspaceId String?
  department  String?
  position    String?
  salary      Float?
  commission  Float?       @default(0)
  hireDate    DateTime?
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  checkIn    DateTime
  checkOut   DateTime?
  status     String    @default("PRESENT")
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id])
}

model Customer {
  id              String         @id @default(cuid())
  userId          String
  name            String
  email           String         @unique
  phone           String?
  company         String?
  licenseType     String?
  areaOfOperation String?
  dealFocus       String?
  budgetRange     String?
  status          String         @default("Active")
  aiSummary       String?
  portalAccess    Boolean        @default(false)
  portalPassword  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  bookings        Booking[]
  user            User           @relation(fields: [userId], references: [id])
  deals           Deal[]
  interactions    Interaction[]
   projects        Project[]
  tasks           Task[]         @relation("CustomerTasks")
  tags            Tag[]          @relation("CustomerToTag")
  onboardings         OnboardingInstance[]
}

model Lead {
  id              String         @id @default(cuid())
  userId          String
  name            String
  email           String         @unique
  phone           String?
  company         String?
  licenseType     String?
  areaOfOperation String?
  dealFocus       String?
  budgetRange     String?
  website         String?
  industry        String?
  location        String?
  address         String?
  rating          String?
  linkedin        String?
  source          String?
  status          String         @default("New")
  emailVerified   Boolean        @default(false)
  isDisposable    Boolean        @default(false)
  aiScore         Int            @default(0)
  aiInsights      String?
  categoryId      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  scrapeJobId     String?
  bookings        Booking[]
  campaigns       CampaignLead[]
  deals           Deal[]
  interactions    Interaction[]
  scrapeJob       ScrapeJob?     @relation(fields: [scrapeJobId], references: [id])
  category        Category?      @relation(fields: [categoryId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
  tasks           Task[]         @relation("LeadTasks")
  tags            Tag[]          @relation("LeadToTag")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  leads     Lead[]

  @@unique([userId, name])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  customers Customer[] @relation("CustomerToTag")
  leads     Lead[]     @relation("LeadToTag")
}

model Pipeline {
  id          String    @id @default(cuid())
  name        String
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  stages      Stage[]
}

model Stage {
  id         String   @id @default(cuid())
  name       String
  order      Int
  pipelineId String
  deals      Deal[]
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
}

model Deal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  value         Float     @default(0)
  stageId       String?
  stage         String    @default("New Lead")
  probability   Int       @default(50)
  expectedClose DateTime?
  leadId        String?
  customerId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer? @relation(fields: [customerId], references: [id])
  lead          Lead?     @relation(fields: [leadId], references: [id])
  stageModel    Stage?    @relation(fields: [stageId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  onboardings         OnboardingInstance[]
}

model Project {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      String     @default("PLANNING")
  workspaceId String?
  customerId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customer    Customer?  @relation(fields: [customerId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  tasks       Task[]     @relation("ProjectTasks")
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  aiActionItems String?
  dueDate       DateTime?
  status        String    @default("Todo")
  priority      String    @default("Medium")
  timeTracked   Int       @default(0)
  projectId     String?
  customerId    String?
  leadId        String?
  assigneeId    String?
  parentTaskId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  parentTask    Task?     @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks      Task[]    @relation("Subtasks")
  assignee      User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  lead          Lead?     @relation("LeadTasks", fields: [leadId], references: [id])
  customer      Customer? @relation("CustomerTasks", fields: [customerId], references: [id])
  project       Project?  @relation("ProjectTasks", fields: [projectId], references: [id])
}

model EmailAccount {
  id           String     @id @default(cuid())
  userId       String
  email        String     @unique
  host         String
  port         Int
  imapHost     String?
  imapPort     Int?
  username     String
  password     String
  encryption   String
  dailyLimit   Int        @default(50)
  sentToday    Int        @default(0)
  warmupStatus Boolean    @default(false)
  isActive     Boolean    @default(true)
  campaigns    Campaign[]
  user         User       @relation(fields: [userId], references: [id])
}

model SocialAccount {
  id           String       @id @default(cuid())
  userId       String
  platform     String
  accessToken  String
  refreshToken String?
  tokenExpires DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id])
  posts        SocialPost[]
}

model SocialPost {
  id              String        @id @default(cuid())
  workspaceId     String
  socialAccountId String
  content         String
  mediaUrls       String?
  status          String        @default("DRAFT")
  scheduledFor    DateTime?
  publishedAt     DateTime?
  likes           Int           @default(0)
  comments        Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
}

model Campaign {
  id             String         @id @default(cuid())
  userId         String
  name           String
  subject        String
  body           String
  type           String         @default("EMAIL")
  status         String         @default("Draft")
  emailAccountId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  emailAccount   EmailAccount?  @relation(fields: [emailAccountId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  leads          CampaignLead[]
}

model CampaignLead {
  id         String    @id @default(cuid())
  campaignId String
  leadId     String
  status     String    @default("Pending")
  sentAt     DateTime?
  openedAt   DateTime?
  repliedAt  DateTime?
  lead       Lead      @relation(fields: [leadId], references: [id])
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
}

model Interaction {
  id         String    @id @default(cuid())
  type       String
  content    String
  sentiment  String?
  date       DateTime  @default(now())
  customerId String?
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])
}

model Booking {
  id         String    @id @default(cuid())
  title      String
  startTime  DateTime
  endTime    DateTime
  userId     String?
  customerId String?
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])
  user       User?     @relation("UserBookings", fields: [userId], references: [id])
}

model Automation {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String?
  triggerType String
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id])
  logs        AutomationLog[]
  steps       WorkflowStep[]
}

model WorkflowStep {
  id           String     @id @default(cuid())
  automationId String
  type         String
  order        Int
  config       String
  automation   Automation @relation(fields: [automationId], references: [id])
}

model AutomationLog {
  id            String     @id @default(cuid())
  automationId  String
  status        String
  message       String?
  executionTime Int
  createdAt     DateTime   @default(now())
  automation    Automation @relation(fields: [automationId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ScrapeJob {
  id         String      @id @default(cuid())
  userId     String
  status     String      @default("Pending")
  progress   Int         @default(0)
  totalLeads Int         @default(0)
  keyword    String?
  location   String?
  message    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  leads      Lead[]
  user       User        @relation(fields: [userId], references: [id])
  logs       ScrapeLog[]
}

model ScrapeLog {
  id        String    @id @default(cuid())
  jobId     String
  message   String
  level     String    @default("INFO")
  createdAt DateTime  @default(now())
  job       ScrapeJob @relation(fields: [jobId], references: [id])
}

model Team {
  id       String    @id @default(cuid())
  name     String
  members  Member[]
  messages Message[]
  rooms    Room[]
}

model Room {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("VIDEO")
  status    String   @default("EMPTY")
  userId    String?
  teamId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])
  user      User?    @relation("UserRooms", fields: [userId], references: [id])
}

model Member {
  id     String @id @default(cuid())
  name   String
  role   String
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  createdAt  DateTime @default(now())
  teamId     String
  senderName String
  team       Team     @relation(fields: [teamId], references: [id])
}

model OnboardingSession {
  id         String              @id @default(cuid())
  leadId     String?
  customerId String?
  status     String              @default("IN_PROGRESS")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  messages   OnboardingMessage[]
}

model OnboardingMessage {
  id        String            @id @default(cuid())
  sessionId String
  content   String
  sender    String
  createdAt DateTime          @default(now())
  session   OnboardingSession @relation(fields: [sessionId], references: [id])
}

model Form {
  id                       String           @id @default(cuid())
  title                    String
  description              String?
  ownerId                  String
  meetingSchedulingEnabled Boolean          @default(false)
  meetingDurationMin       Int              @default(60)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  owner                    User             @relation("UserForms", fields: [ownerId], references: [id])
  fields                   FormField[]
  submissions              FormSubmission[]
}

model FormField {
  id        String   @id @default(cuid())
  formId    String
  label     String
  type      String
  required  Boolean  @default(false)
  options   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  data      String
  createdAt DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model CalendarSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  availableStart    String   @default("09:00")
  availableEnd      String   @default("17:00")
  timeZone          String   @default("UTC")
  reminderAccountId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  start        DateTime
  end          DateTime
  isLocked     Boolean  @default(false)
  source       String?
  meetingId    String?
  externalMeta String?
  reminderSent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Newsletter {
  id        String    @id @default(cuid())
  subject   String
  body      String
  recipientCount Int  @default(0)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String
}

model SystemEmailProfile {
  id         String   @id @default(cuid())
  profile    String   @unique
  host       String?
  port       Int      @default(587)
  username   String?
  password   String?
  fromEmail  String?
  fromName   String?
  secureMode String   @default("STARTTLS")
  isEnabled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PricingPlan {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  description       String   @default("")
  monthlyPriceCents Int?
  seatLimit         Int?
  featuresJson      String   @default("[]")
  stripePriceId     String?
  isActive          Boolean  @default(true)
  isPopular         Boolean  @default(false)
  sortOrder         Int      @default(0)
  trialDays         Int      @default(14)
  ctaLabel          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PricingOffer {
  id                String   @id @default(cuid())
  title             String
  description       String   @default("")
  discountPercent   Int
  couponCode        String?
  startsAt          DateTime
  endsAt            DateTime
  isActive          Boolean  @default(true)
  appliesToPlanSlug String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


// ============================================================================
// AI-POWERED CLIENT ONBOARDING ENGINE
// ============================================================================

model OnboardingInstance {
  id                    String                   @id @default(cuid())
  clientId              String
  opportunityId         String?
  serviceName           String                   @default("AI Automation Implementation")
  templateId            String?
  status                String                   @default("INITIALISING") // INITIALISING, WAITING_INTERNAL_INFORMATION, AI_PLANNING, WAITING_HUMAN_APPROVAL, WAITING_CLIENT, IN_PROGRESS, AT_RISK, BLOCKED, READY_FOR_ACTIVATION, COMPLETED, CANCELLED
  healthStatus          String                   @default("HEALTHY") // HEALTHY, AT_RISK, BLOCKED
  healthReason          String?
  progressPercentage    Int                      @default(0)
  onboardingOwnerId     String?
  commercialDetails     String?                  // JSON string: price, duration, paymentTerms, startDate, accountManager, notes
  analysisJson          String?                  // JSON string: known, missing, verification, optional
  planJson              String?                  // JSON string: commercial, legal, operational, communication
  secureToken           String                   @unique @default(cuid())
  tokenExpiresAt        DateTime
  startedAt             DateTime                 @default(now())
  targetCompletionDate  DateTime?
  completedAt           DateTime?
  invoiceId             String?
  invoiceStatus         String?                  @default("DRAFT")
  invoiceAmount         Float?                   @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  client                Customer                 @relation(fields: [clientId], references: [id])
  deal                  Deal?                    @relation(fields: [opportunityId], references: [id])
  template              ServiceOnboardingTemplate? @relation(fields: [templateId], references: [id])
  owner                 User?                    @relation("OnboardingOwner", fields: [onboardingOwnerId], references: [id])
  actions               AIAction[]
  documents             Document[]
  responses             ClientResponse[]
  communications        OnboardingCommunication[]
  signatureRequests     SignatureRequest[]
  auditEvents           OnboardingAuditEvent[]
}

model ServiceOnboardingTemplate {
  id                        String               @id @default(cuid())
  name                      String
  code                      String               @unique // AI_AUTOMATION, CYBERSECURITY, TALENT_BRIDGE, etc.
  description               String?
  isActive                  Boolean              @default(true)
  requiredDocumentsJson     String               @default("[]") // Array of doc types: WELCOME_LETTER, NDA, SERVICE_AGREEMENT, DPA
  requiredInformationJson   String               @default("[]") // Internal & client question definitions
  requiredSignaturesJson    String               @default("[]") // Document types requiring digital signature
  paymentRequirementsJson   String               @default("{}") // e.g. { advancePercent: 50, terms: "Net 14" }
  complianceRequirementsJson String              @default("[]") // e.g. ["GDPR_DPA", "CONFIDENTIALITY"]
  communicationSequenceJson String               @default("[]") // email templates sequence
  completionConditionsJson  String               @default("[]") // conditions for completion
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  instances                 OnboardingInstance[]
}

model AIAction {
  id                String              @id @default(cuid())
  onboardingId      String
  actionType        String              // GENERATE_DOCUMENT, CREATE_INVOICE, REQUEST_SIGNATURE, GENERATE_COMMUNICATION, CREATE_TASK, SCHEDULE_FOLLOWUP, UPDATE_STATUS, FLAG_EXCEPTION, GENERATE_SOP, GENERATE_PROJECT_BRIEF, ACTIVATE_CLIENT
  description       String
  payload           String              // JSON payload
  riskLevel         String              @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  requiresApproval  Boolean             @default(true)
  status            String              @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, EXECUTED, FAILED
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectionReason   String?
  executedAt        DateTime?
  executionResult   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  onboarding        OnboardingInstance  @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
}

model DocumentTemplate {
  id                String              @id @default(cuid())
  name              String
  type              String              @unique // WELCOME_LETTER, NDA, SERVICE_AGREEMENT, TERMS, PRIVACY_NOTICE, DPA, INVOICE, PROJECT_BRIEF, IMPLEMENTATION_SOP, REQUIREMENTS_DOCUMENT, KICKOFF_DOCUMENT, PAYMENT_REMINDER, OTHER
  content           String              // Standard template with {{mustache}} interpolation variables
  variablesJson     String              @default("[]")
  requiresApproval  Boolean             @default(true)
  requiresSignature Boolean             @default(false)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  documents         Document[]
}

model Document {
  id                String              @id @default(cuid())
  onboardingId      String
  clientId          String
  templateId        String?
  documentType      String
  title             String
  status            String              @default("DRAFT") // DRAFT, AI_GENERATED, UNDER_REVIEW, CHANGES_REQUESTED, APPROVED, SENT, VIEWED, SIGNED, REJECTED, SUPERSEDED, EXPIRED
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  onboarding        OnboardingInstance  @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  template          DocumentTemplate?   @relation(fields: [templateId], references: [id])
  versions          DocumentVersion[]
  signatureRequests SignatureRequest[]
}

model DocumentVersion {
  id                String              @id @default(cuid())
  documentId        String
  versionNumber     Int                 @default(1)
  content           String              // Rendered content snapshot
  generatedBy       String              @default("AI")
  generatedAt       DateTime            @default(now())
  approvedBy        String?
  approvedAt        DateTime?
  sentAt            DateTime?
  signedAt          DateTime?
  supersededBy      String?
  fileUrl           String?
  createdAt         DateTime            @default(now())

  document          Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model SignatureRequest {
  id                String              @id @default(cuid())
  onboardingId      String
  documentId        String
  title             String
  status            String              @default("DRAFT") // NOT_REQUIRED, DRAFT, READY, SENT, VIEWED, PARTIALLY_SIGNED, SIGNED, DECLINED, EXPIRED
  token             String              @unique @default(cuid())
  expiresAt         DateTime
  completedAt       DateTime?
  auditCertificate  String?             // JSON containing IP, user-agent, timestamp, document hash, verification seal
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  onboarding        OnboardingInstance  @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  document          Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signatories       Signatory[]
}

model Signatory {
  id                  String            @id @default(cuid())
  signatureRequestId  String
  name                String
  email               String
  role                String            @default("Client Signer")
  status              String            @default("PENDING") // PENDING, SIGNED, DECLINED
  signedAt            DateTime?
  signatureType       String?           // DRAWN, TYPED
  signatureData       String?           // Base64 image or typed signature representation
  ipAddress           String?
  userAgent           String?
  consentGiven        Boolean           @default(false)
  consentTimestamp    DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  signatureRequest    SignatureRequest  @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
}

model ClientResponse {
  id                String              @id @default(cuid())
  onboardingId      String
  clientId          String
  questionKey       String
  questionLabel     String
  response          String
  responseType      String              @default("text") // text, choice, boolean, file, verification
  submittedAt       DateTime            @default(now())
  source            String              @default("PORTAL") // PORTAL, INTERNAL
  verified          Boolean             @default(true)

  onboarding        OnboardingInstance  @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
}

model OnboardingCommunication {
  id                String              @id @default(cuid())
  onboardingId      String
  type              String              // WELCOME, SIGNATURE_REQUEST, REQUIREMENTS_REQUEST, PAYMENT_REMINDER, KICKOFF, PROGRESS_UPDATE, COMPLETION, DELAY_NOTICE
  subject           String
  body              String
  recipientEmail    String
  status            String              @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, SENT, FAILED
  approvedBy        String?
  approvedAt        DateTime?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  onboarding        OnboardingInstance  @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
}

model OnboardingAuditEvent {
  id                String              @id @default(cuid())
  onboardingId      String
  actorId           String              // User ID, or "AI", or "CLIENT", or "SYSTEM"
  actorType         String              // USER, AI, CLIENT, SYSTEM
  action            String              // INSTANCE_CREATED, INTERNAL_DETAILS_SUBMITTED, PLAN_GENERATED, ACTION_APPROVED, etc.
  details           String
  metadataJson      String?
  ipAddress         String?
  createdAt         DateTime            @default(now())

  onboarding        OnboardingInstance  @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
}
